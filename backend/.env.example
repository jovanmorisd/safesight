# Copy to backend/.env and fill in. Never commit .env; the service key is a secret.
# Leave the Supabase values empty to use the local SQLite file + local image folder.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (port 5432).
# On Vercel use the "Transaction pooler" (port 6543) instead: the session pooler allows only
# 15 clients, which serverless instances quickly use up.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=

# Supabase → Project Settings → API (or Data API): Project URL and the service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Private bucket for photos, annotated images, worker crops and uploaded model weights.
# Created automatically on first start.
SUPABASE_BUCKET=ppe-media

# Delete inspections (rows + images) older than this many days. 0 = keep forever.
RETENTION_DAYS=30

# Signs login sessions. Set a long random value when hosting (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))").
# If empty, one is generated once and stored in the database.
SECRET_KEY=

# Let anyone create an account (true) or only the first admin (false).
ALLOW_SIGNUP=true

# --- Password-reset emails (SMTP). Leave SMTP_HOST empty to print reset links in the server log instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASSWORD=<16-char App Password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SafeSight <you@gmail.com>
# Public address of the app, used in the emailed links (e.g. https://safesight.example.com).
APP_URL=http://localhost:8000
